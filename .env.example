# Firebase Realtime Database Configuration for JPC FTU (Template)
# Điền các giá trị thực tế vào file .env cục bộ (không commit file .env lên git)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=jpc-ftu.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://jpc-ftu-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=jpc-ftu
VITE_FIREBASE_STORAGE_BUCKET=jpc-ftu.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
